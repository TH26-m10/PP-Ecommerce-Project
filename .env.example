# Copy to .env and fill in your local values (never commit .env)

DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DB_PASSWORD=
DB_NAME=store
DB_USER=root
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional — required only for invoice emails (Celery task)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

CELERY_BROKER_URL=redis://localhost:6379/0
